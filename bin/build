#!/usr/bin/env bash
set -euo pipefail
project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
build_dir="$project_dir/build/app"
mkdir -p "$build_dir"
cd "$build_dir"
qmake6 "$project_dir/omadraft.pro" CONFIG+=release
make -j"${OMADRAFT_JOBS:-$(nproc)}"
printf '\nBuilt %s/omadraft\n' "$build_dir"
